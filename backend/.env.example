# ===========================================
# MacroMap Configuration
# ===========================================

# LLM Provider (choose one: openai, ollama, bedrock, huggingface)
LLM_PROVIDER=openai

# ----- OpenAI Settings (Recommended) -----
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o

# ----- Ollama Settings (Local Development) -----
# Install Ollama: https://ollama.ai
# Then run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ----- AWS Bedrock Settings (Production) -----
# Requires AWS credentials configured (aws configure)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=meta.llama3-8b-instruct-v1:0

# ----- Hugging Face Settings (Alternative) -----
HF_MODEL_ID=microsoft/phi-3-mini-4k-instruct
HF_API_TOKEN=hf_your_token_here

# ----- Chat Settings -----
MAX_HISTORY_LENGTH=10
MAX_TOKENS=2048
TEMPERATURE=0.7

# ----- SEC EDGAR Settings -----
SEC_USER_AGENT=MacroMap your-email@example.com

# ----- Debug -----
DEBUG=true
